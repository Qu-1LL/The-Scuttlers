*.binlog
*.trx
*.coverage
*.coveragexml
*.dll
*.exe
*.pdb
*.apphost

# MonoGame compiled content
**/Content/[Bb]in/
**/Content/[Oo]bj/
*.xnb
*.mgcontent

# NuGet/package restore leftovers
packages/

